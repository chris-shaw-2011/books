{
	"name": "@books/client",
	"type": "module",
	"dependencies": {
		"@books/shared": "file:../shared",
		"bootstrap": "^5.3.8",
		"classnames": "^2.5.1",
		"dayjs": "^1.11.21",
		"rc-progress": "^4.0.0",
		"react": "^19.2.7",
		"react-animate-height": "^3.2.4",
		"react-bootstrap": "^2.10.10",
		"react-cookie": "^8.1.2",
		"react-cool-onclickoutside": "^1.7.0",
		"react-dom": "^19.2.7",
		"react-highlight-words": "^0.21.0",
		"react-textarea-autosize": "^8.5.9",
		"react-virtuoso": "^4.18.10",
		"sass": "^1.101.0",
		"universal-cookie": "^8.1.2",
		"uuid": "^14.0.1",
		"zustand": "^5.0.14"
	},
	"scripts": {
		"start": "vite",
		"build": "npm run scss-types && npm run build-tsc && npm run build-vite",
		"build-tsc": "tsc -b",
		"build-vite": "vite build",
		"lint": "npm run scss-types:check && eslint .",
		"lint:fix": "npm run scss-types && eslint . --fix",
		"scss-types": "typed-scss-modules \"src/app/**/*.module.scss\" --exportType default --nameFormat none --quoteType double --outputFolder .generated --updateStaleOnly --logLevel error",
		"scss-types:check": "typed-scss-modules \"src/app/**/*.module.scss\" --exportType default --nameFormat none --quoteType double --outputFolder .generated --listDifferent --logLevel error",
		"scss-types:watch": "typed-scss-modules \"src/app/**/*.module.scss\" --exportType default --nameFormat none --quoteType double --outputFolder .generated --updateStaleOnly --watch --logLevel error"
	},
	"proxy": "http://localhost:3001",
	"devDependencies": {
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/react-highlight-words": "^0.20.1",
		"@vitejs/plugin-react": "^6.0.3",
		"@tsjam/typed-scss-modules": "^10.2.0",
		"vite": "^8.1.4"
	}
}
