{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"rootDirs": [
			".",
			".generated"
		],
		"types": [
			"vite/client",
			"node"
		]
	},
	"include": [
		".generated/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"vite.config.ts",
		"test/**/*.ts"
	]
}
