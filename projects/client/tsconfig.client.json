{
	"compilerOptions": {
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"baseUrl": ".",
		"paths": {
			"@books/shared": [
				"../shared/src/index.ts"
			],
			"@books/*": [
				"../*/src"
			],
		},
		"outDir": "../../bin/projects/client",
		"module": "ESNext",
		"moduleResolution": "Bundler",
	},
	"extends": "../../tsconfig.base.json",
	"include": [
		"src",
		"vite.config.ts"
	],
	"references": [
		{
			"path": "../shared"
		}
	]
}