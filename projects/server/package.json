	"main": "./src/index.ts",
	"scripts": {
		"start": "node ./src/index.ts",
		"start-production": "node ./src/index.js",
		"build": "tsc --project ./tsconfig.production.json && npm run copy-package && npm run copy-audible-hack",
		"copy-package": "cpx \"./package.json\" \"../../bin/projects/server/\"",
		"copy-audible-hack": "cpx \"./src/inAudible-NG/**/*\" \"../../bin/projects/server/src/inAudible-NG\"",
