{
	"name": "@books/server",
	"type": "module",
	"dependencies": {
		"@books/shared": "file:../shared",
		"@fastify/multipart": "^9.2.1",
		"@fastify/static": "^8.2.0",
		"async-mutex": "^0.5.0",
		"bcrypt": "^6.0.0",
		"chokidar": "^4.0.3",
		"cookie": "^1.0.2",
		"dayjs": "^1.11.18",
		"fastify": "^5.6.0",
		"ffmpeg-ffprobe-static": "^6.1.2-rc.1",
		"get-folder-size": "^5.0.0",
