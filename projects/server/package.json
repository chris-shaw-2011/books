{
	"name": "@books/server",
	"type": "module",
	"dependencies": {
		"@books/shared": "file:../shared",
		"@fastify/multipart": "^10.1.6",
		"@fastify/static": "^10.1.8",
		"async-mutex": "^0.5.0",
		"bcrypt": "^6.0.0",
		"chokidar": "^6.0.0",
		"cookie": "^2.0.1",
		"fastify": "^5.12.7",
		"ffmpeg-ffprobe-static": "^6.1.2-rc.1",
		"node-pty": "^1.1.0",
		"node-taglib-sharp": "^6.0.3",
		"nodemailer": "^10.2.1",
		"sanitize-filename": "^1.6.4",
		"unzipper": "^0.12.5"
	},
	"main": "./src/index.ts",
	"scripts": {
		"start": "node --require ttsc/register ./src/index.ts",
		"start-production": "node ./src/index.js",
		"build": "ttsc --project ./tsconfig.build.json && npm run copy-package && npm run copy-audible-hack",
		"migrate-db": "node --require ttsc/register ./src/migrateDatabase.ts",
		"copy-package": "node ../../scripts/copy.ts ./package.json ../../bin/projects/server/",
		"copy-audible-hack": "node ../../scripts/copy.ts ./src/inAudible-NG ../../bin/projects/server/src/inAudible-NG",
		"test": "node --require ttsc/register --test --test-concurrency=1 ./test/**/*.test.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/node": "^26.6.5",
		"@types/unzipper": "^0.10.11"
	}
}
