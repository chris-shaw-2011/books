{
	"name": "books-monorepo",
	"version": "1.4.0",
	"engines": {
		"npm": ">=10.9.2",
		"node": ">=26.5.0"
	},
	"workspaces": [
		"./projects/*"
	],
	"private": true,
	"packageManager": "npm@11.10.1",
	"scripts": {
		"start": "concurrently \"npm run start-client\" \"npm run start-server\"",
		"start-production": "npm run build && cpx projects/server/db.sqlite bin/projects/server && cd bin && npm install --omit=dev && cd projects/server && npm run start-production",
		"start-client": "npm start -w @books/client",
		"start-server": "npm start -w @books/server",
		"install-packages": "npm install",
		"build": "npm run copy-package && npm run build-client && npm run build-shared && npm run build-server",
		"build-client": "npm run build --workspace=@books/client",
		"build-server": "npm run build --workspace=@books/server",
		"build-shared": "npm run build --workspace=@books/shared",
		"copy-package": "cpx \"./package.json\" \"./bin\"",
		"lint": "npm run lint:root && npm run lint:workspaces",
		"lint:root": "eslint . --ignore-pattern \"projects/**\"",
		"lint:workspaces": "npm run lint --workspaces --if-present",
		"lint:fix": "npm run lint:fix:root && npm run lint:fix --workspaces --if-present",
		"lint:fix:root": "eslint . --fix --ignore-pattern \"projects/**\"",
		"analyze": "source-map-explorer 'bin/client/*.js'",
		"knip": "knip --config knip.config.ts --reporter compact",
		"sherif": "sherif"
	},
	"type": "module",
	"devDependencies": {
		"@chris-shaw-2011/lint": "^1.0.3",
		"concurrently": "^10.0.3",
		"cpx2": "^9.0.0",
		"source-map-explorer": "^2.5.3",
		"typescript": "^7.0.2"
	},
	"allowScripts": {
		"bcrypt@6.0.0": true,
		"utimes@5.2.1": true,
		"ffmpeg-static@5.3.0": true,
		"ffmpeg-ffprobe-static@6.1.2-rc.1": true,
		"esbuild@0.27.7": true,
		"@parcel/watcher@2.5.6": true
	}
}
