{
	"name": "books-monorepo",
	"version": "1.2.0",
	"engines": {
		"npm": ">=10.9.2",
		"node": ">=24.0.2"
	},
	"workspaces": [
		"./projects/*"
	],
	"private": true,
	"packageManager": "npm@10.9.2",
	"scripts": {
		"start": "concurrently \"npm run start-client\" \"npm run start-server\"",
		"start-production": "npm run build && cpx projects/server/db.sqlite bin/projects/server && cd bin && npm install --omit=dev && cd projects/server && npm run start-production",
		"start-client": "npm start -w @books/client",
		"start-server": "npm start -w @books/server",
		"install-packages": "npm install",
		"build": "npm run copy-package && npm run build-client && npm run build-shared && npm run build-server",
		"build-client": "npm run build --workspace=@books/client",
		"build-server": "npm run build --workspace=@books/server",
		"build-shared": "npm run build --workspace=@books/shared",
		"copy-package": "cpx \"./package.json\" \"./bin\"",
		"lint": "eslint . --max-warnings 0 --report-unused-disable-directives-severity error && npm run lint-client && npm run lint-server && npm run lint-shared && knip && npm run sherif",
		"lint-client": "npm run lint --workspace=@books/client",
		"lint-server": "npm run lint --workspace=@books/server",
		"lint-shared": "npm run lint --workspace=@books/shared",
		"analyze": "source-map-explorer 'bin/client/*.js'",
		"knip": "knip",
		"sherif": "sherif"
	},
	"type": "module",
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@stylistic/eslint-plugin": "^5.7.1",
		"concurrently": "^9.2.1",
		"cpx2": "^8.0.0",
		"eslint": "^9.39.2",
		"knip": "^5.82.1",
		"sherif": "^1.10.0",
		"source-map-explorer": "^2.5.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.1"
	}
}